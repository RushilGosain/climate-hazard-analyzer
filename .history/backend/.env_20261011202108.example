# Copy to .env and edit. None of these are secrets except the two marked.
MONGODB_URI=mongodb://localhost:27017        # SECRET in production (Atlas connection string)
MONGODB_DB=climate_hazards
USE_MOCK_DB=0                                # 1 = run without MongoDB (in-memory)
CORS_ORIGINS=http://localhost:5173           # comma separated list of allowed frontend origins
RATE_LIMIT_DEFAULT=300 per hour
RATE_LIMIT_ANALYZE=20 per minute
CACHE_TTL_SECONDS=3600
OPEN_METEO_API_KEY=                          # SECRET, optional, only for commercial use
